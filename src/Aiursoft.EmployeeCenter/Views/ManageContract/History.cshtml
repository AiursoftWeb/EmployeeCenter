@model Aiursoft.EmployeeCenter.Models.ContractViewModels.HistoryViewModel

<h3>@Localizer["Contract History"]</h3>
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link" asp-action="Index">@Localizer["Contracts"]</a></li>
    <li class="nav-item"><a class="nav-link active" asp-action="History">@Localizer["Operation History"]</a></li>
</ul>
<div class="card">
    <partial name="_ContractHistoryTable" model="Model.History" />
</div>
<nav class="mt-3" aria-label="@Localizer["History pages"]">
    @if (Model.CurrentPage > 1)
    {
        <a class="btn btn-outline-primary" asp-action="History" asp-route-contractKey="@Model.ContractKey" asp-route-page="@(Model.CurrentPage - 1)">@Localizer["Previous"]</a>
    }
    @if (Model.HasNextPage)
    {
        <a class="btn btn-outline-primary" asp-action="History" asp-route-contractKey="@Model.ContractKey" asp-route-page="@(Model.CurrentPage + 1)">@Localizer["Next"]</a>
    }
</nav>
