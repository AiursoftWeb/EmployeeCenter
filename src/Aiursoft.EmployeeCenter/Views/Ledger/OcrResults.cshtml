@model Aiursoft.EmployeeCenter.Models.LedgerViewModels.OcrResultsViewModel

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["OCR Results"] - @Model.Transaction.Description</h3>
        <p class="text-muted">@Model.Transaction.TransactionTime.ToString("yyyy-MM-dd HH:mm")</p>
    </div>

    <div class="col-auto ms-auto mt-n1">
        <a asp-action="Transactions" asp-route-id="@(Model.Transaction.SourceAccount?.CompanyEntityId ?? Model.Transaction.DestinationAccount?.CompanyEntityId)" class="btn btn-secondary">
            <i class="align-middle" data-lucide="arrow-left"></i> @Localizer["Back to Transactions"]
        </a>
    </div>
</div>

@if (!Model.OcrResults.Any())
{
    <div class="alert alert-info">
        @Localizer["No OCR results found for this transaction. OCR might still be processing or failed. Note: only PDF files are supported."]
    </div>
}
else
{
    <div class="row">
        @foreach (var result in Model.OcrResults.OrderBy(r => r.AttachmentType))
        {
            <div class="col-12 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="align-middle" data-lucide="file-text"></i>
                            @Localizer[result.AttachmentType.ToString()]
                        </h5>
                    </div>
                    <div class="card-body">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="plain-text-tab-@result.Id" data-bs-toggle="tab" href="#plain-text-@result.Id" role="tab">@Localizer["Plain Text"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="json-result-tab-@result.Id" data-bs-toggle="tab" href="#json-result-@result.Id" role="tab">@Localizer["Raw JSON"]</a>
                            </li>
                        </ul>
                        <div class="tab-content mt-3">
                            <div class="tab-pane fade show active" id="plain-text-@result.Id" role="tabpanel">
                                <pre class="bg-light p-3 border rounded" style="white-space: pre-wrap;">@result.PlainText</pre>
                            </div>
                            <div class="tab-pane fade" id="json-result-@result.Id" role="tabpanel">
                                <pre class="bg-light p-3 border rounded"><code>@result.JsonResult</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@Localizer["OCR Status Info"]</h5>
    </div>
    <div class="card-body">
        <table class="table table-sm">
            <tr>
                <th>@Localizer["Attempt Count"]</th>
                <td>@Model.Transaction.OcrAttemptCount</td>
            </tr>
            <tr>
                <th>@Localizer["Last Attempt"]</th>
                <td>
                    @if (Model.Transaction.LastOcrAttemptTime.HasValue)
                    {
                        <label data-utc-time="@Model.Transaction.LastOcrAttemptTime.Value.ToHtmlDateTime()"></label>
                    }
                    else
                    {
                        <span>@Localizer["Never"]</span>
                    }
                </td>
            </tr>
        </table>
    </div>
</div>
