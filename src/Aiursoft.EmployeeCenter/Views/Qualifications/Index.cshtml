@model Aiursoft.EmployeeCenter.Models.QualificationsViewModels.IndexViewModel
@inject IHtmlLocalizer<Aiursoft.EmployeeCenter.Models.QualificationsViewModels.IndexViewModel> Localizer
<div class="container-fluid">
    <h1 class="h3">@Localizer["Business Qualifications"]</h1>
    <div class="mb-3">
        <a asp-action="Records" class="btn btn-secondary">@Localizer["My Download Records"]</a>
    </div>
    <div class="alert alert-info">@Localizer["Originals are private. Specify the business purpose and recipient to generate a personalized watermarked copy."]</div>
    <div class="card"><div class="card-body table-responsive">
        <table class="table">
            <thead><tr><th>@Localizer["Company"]</th><th>@Localizer["Qualification"]</th><th>@Localizer["Version"]</th><th>@Localizer["Status"]</th><th>@Localizer["Actions"]</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Qualifications)
            {
                <tr>
                    <td>@item.CompanyEntity.CompanyName</td><td>@item.Name</td><td>@item.Version</td>
                    <td>@Localizer["Enabled"]</td>
                    <td>
                    @if (item.IsActive)
                    {
                        <a asp-action="Apply" asp-route-id="@item.Id" class="btn btn-primary btn-sm">@Localizer["Generate Watermark and Download"]</a>
                    }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Qualifications.Count == 0) { <p>@Localizer["No qualifications available."]</p> }
    </div></div>
</div>
