@model Aiursoft.EmployeeCenter.Models.QualificationsViewModels.ApplyViewModel
<div class="container-fluid">
    <h1 class="h3">@Localizer["Generate Watermark and Download"]</h1>
    <p>@Model.Qualification?.CompanyEntity.CompanyName — @Model.Qualification?.Name (@Model.Qualification?.Version)</p>
    <div class="alert alert-info">@Localizer["The server adds visible and invisible tracking watermarks. The applicant identity comes from your account and cannot be changed in this form."]</div>
    <form asp-action="Apply" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label class="form-label">@Localizer["Applicant"]</label><div class="form-control-plaintext">@Model.ApplicantName</div></div>
        <div class="mb-3">
            <label asp-for="Purpose" class="form-label">@Localizer["Business Purpose"]</label>
            <input asp-for="Purpose" class="form-control" />
            <span asp-validation-for="Purpose" class="text-danger"></span>
            <small>@Localizer["Specify the actual transaction, for example supplier onboarding or a named project tender."]</small>
        </div>
        <div class="mb-3">
            <label asp-for="Recipient" class="form-label">@Localizer["Recipient Company"]</label>
            <input asp-for="Recipient" class="form-control" />
            <span asp-validation-for="Recipient" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="WatermarkLanguage" class="form-label">@Localizer["Watermark Language"]</label>
            <select asp-for="WatermarkLanguage" class="form-select">
                <option value="auto">@Localizer["Follow Interface Language"]</option>
                <option value="zh-CN">@Localizer["Simplified Chinese"]</option>
                <option value="zh-HK">@Localizer["Traditional Chinese (Hong Kong)"]</option>
                <option value="en-US">English</option>
            </select>
            <span asp-validation-for="WatermarkLanguage" class="text-danger"></span>
            <small>@Localizer["Only the watermark labels change language. The purpose, recipient and account name are not translated. Choose English and enter the purpose and recipient in English for an English copy. Existing copies do not change."]</small>
        </div>
        <button type="submit" class="btn btn-primary">@Localizer["Generate and Preview"]</button>
        <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
    </form>
</div>
