@model Aiursoft.EmployeeCenter.Models.QualificationsViewModels.ApplyViewModel
<div class="container-fluid">
    <h1 class="h3">@Localizer["Generate Watermark and Download"]</h1>
    <p>@Model.Qualification?.CompanyEntity?.CompanyName — @Model.Qualification?.Name (@Model.Qualification?.Version)</p>
    <div class="alert alert-info">@Localizer["The server adds visible and invisible tracking watermarks. The applicant identity comes from your account and cannot be changed in this form."]</div>
    <form asp-action="Apply" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label class="form-label">@Localizer["Applicant"]</label><input value="@Model.ApplicantName" class="form-control" readonly /></div>
        <div class="mb-3"><label asp-for="Purpose" class="form-label">@Localizer["Business Purpose"]</label><input asp-for="Purpose" class="form-control" minlength="4" maxlength="120" required /><small>@Localizer["Specify the actual transaction, for example supplier onboarding or a named project tender."]</small></div>
        <div class="mb-3"><label asp-for="Recipient" class="form-label">@Localizer["Recipient Company"]</label><input asp-for="Recipient" class="form-control" minlength="2" maxlength="100" required /></div>
        <button type="submit" class="btn btn-primary">@Localizer["Generate and Preview"]</button>
        <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
    </form>
</div>
