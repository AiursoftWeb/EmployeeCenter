@model Aiursoft.EmployeeCenter.Models.DnsAuditViewModels.CreateDomainAliasViewModel
@using Aiursoft.EmployeeCenter.Authorization
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    var canRunAudit = (await AuthorizationService.AuthorizeAsync(User, null, AppPermissionNames.CanRunServiceAudit)).Succeeded;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h3 mb-1">@Localizer["Register domain alias"]</h1>
                <p class="text-muted mb-0">@Localizer["Choose an audited, unregistered DNS hostname and connect it to an existing service."]</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>

        @if (Model.AvailableSourceDomains.Count == 0)
        {
            <div class="alert alert-info">
                <h5 class="alert-heading">@Localizer["No alias candidates are available"]</h5>
                <p>@Localizer["Run a service audit first. New aliases can only be created from audited DNS hostnames that are not already registered as services or aliases."]</p>
                @if (canRunAudit)
                {
                    <form asp-action="RefreshAudit" method="post">
                        <button type="submit" class="btn btn-primary"><i class="align-middle me-1" data-lucide="refresh-cw"></i>@Localizer["Audit Now"]</button>
                    </form>
                }
            </div>
        }
        else
        {
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Domain" class="form-label"></label>
                        <select asp-for="Domain" class="form-select">
                            <option value="">-- @Localizer["Select audited DNS hostname"] --</option>
                            @foreach (var domain in Model.AvailableSourceDomains)
                            {
                                <option value="@domain">@domain</option>
                            }
                        </select>
                        <div class="form-text">@Localizer["Only current Unknown DNS findings can become aliases."]</div>
                        <span asp-validation-for="Domain" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label"></label>
                        <select asp-for="Type" class="form-select">
                            <option value="0">@Localizer["HTTP redirect"]</option>
                            <option value="1">@Localizer["DNS CNAME"]</option>
                        </select>
                        <div class="form-text">@Localizer["HTTP aliases verify a precise redirect URL. CNAME aliases verify that DNS points directly to the selected service hostname."]</div>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TargetServiceId" class="form-label"></label>
                        <select asp-for="TargetServiceId" class="form-select" id="target-service">
                            <option value="">-- @Localizer["Select target service"] --</option>
                            @foreach (var service in Model.AllServices)
                            {
                                <option value="@service.Id" data-target-url="https://@Aiursoft.EmployeeCenter.Services.DnsAudit.DnsAuditAnalyzer.NormalizeDomain(service.PrimaryDomain)/">@service.PrimaryDomain</option>
                            }
                        </select>
                        <span asp-validation-for="TargetServiceId" class="text-danger"></span>
                    </div>
                    <div class="mb-3" id="target-url-group">
                        <label asp-for="TargetUrl" class="form-label"></label>
                        <input asp-for="TargetUrl" class="form-control" type="url" placeholder="https://target.example.com/" />
                        <div class="form-text">@Localizer["The audit requires the first redirect Location header to match this URL exactly."]</div>
                        <span asp-validation-for="TargetUrl" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-success">
                        <i class="align-middle me-1" data-lucide="split"></i> @Localizer["Register alias and audit now"]
                    </button>
                </div>
            </div>
        </form>
        }
    </div>
</div>

<script>
    const aliasType = document.getElementById('Type');
    const targetService = document.getElementById('target-service');
    const targetUrl = document.getElementById('TargetUrl');
    const targetUrlGroup = document.getElementById('target-url-group');

    function updateTargetUrl() {
        const option = targetService?.selectedOptions[0];
        if (aliasType?.value === '0' && option?.dataset.targetUrl && targetUrl) {
            targetUrl.value = option.dataset.targetUrl;
        }
    }

    function updateAliasType() {
        const isCname = aliasType?.value === '1';
        targetUrlGroup?.classList.toggle('d-none', isCname);
        if (targetUrl) {
            targetUrl.disabled = isCname;
        }
        if (!isCname && !targetUrl?.value) {
            updateTargetUrl();
        }
    }

    targetService?.addEventListener('change', event => {
        const option = event.target.selectedOptions[0];
        if (aliasType?.value === '0' && option?.dataset.targetUrl && targetUrl) {
            targetUrl.value = option.dataset.targetUrl;
        }
    });
    aliasType?.addEventListener('change', updateAliasType);
    updateAliasType();
</script>
