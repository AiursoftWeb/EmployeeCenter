@using Aiursoft.EmployeeCenter.Services
@inject CertificateLocalizationService CertificateLocalizationService
@model Aiursoft.EmployeeCenter.Models.CertificateViewModels.PrintViewModel
@{
    Layout = null;
    var content = CertificateLocalizationService.BuildCertificate(
        Model.Type,
        Model.CertificateLanguage,
        Model.TargetUser!,
        Model.CompanyName,
        Model.CompanyNameEnglish,
        DateTime.Today);
}

<!DOCTYPE html>
<html lang="@Model.CertificateLanguage" dir="@(Model.CertificateLanguage == "ar-SA" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@content.Title</title>
    <style>
        body {
            font-family: "Microsoft YaHei", Arial, sans-serif;
            margin: 2cm;
            line-height: 1.6;
        }
        .header {
            text-align: center;
            margin-bottom: 2cm;
        }
        .title {
            font-size: 24pt;
            font-weight: bold;
        }
        .content {
            font-size: 14pt;
            text-indent: 2em;
            margin-bottom: 2cm;
        }
        .footer {
            float: right;
            text-align: right;
            margin-top: 2cm;
        }
        [dir="rtl"] .footer {
            float: left;
            text-align: left;
        }
        .company-name {
            font-size: 16pt;
            font-weight: bold;
        }
        .date {
            margin-top: 0.5cm;
        }
        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">@content.Title</div>
    </div>

    <div class="content">
        <p>@Html.Raw(content.Paragraph1Html)</p>
        <p>@Html.Raw(content.Paragraph2Html)</p>
    </div>

    <div class="footer">
        <div class="company-name">@content.DisplayedCompanyName</div>
        <div class="date">@content.FormattedIssueDate</div>
    </div>

    <script>
        window.onload = function () {
            window.print();
        };
    </script>
</body>
</html>
