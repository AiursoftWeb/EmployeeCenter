@using System.Globalization
@using Aiursoft.EmployeeCenter.Services
@model Aiursoft.EmployeeCenter.Models.CertificateViewModels.PrintViewModel
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    if (!CertificateLocalizationService.SupportedCultures.ContainsKey(currentCulture))
    {
        currentCulture = "zh-CN";
    }
}

<div class="container-fluid p-0">
    <h1 class="h3 mb-3">@Localizer["Print Certificate of Income"]</h1>

    <div class="row">
        <div class="col-12 col-xl-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">@Localizer["Options"]</h5>
                    <h6 class="card-subtitle text-muted">@Localizer["Select the language for the certificate."]</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Print" method="post" target="_blank">
                        <input type="hidden" name="type" value="@Model.Type" />
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Language"]</label>
                            <select name="lang" class="form-select">
                                @foreach (var culture in CertificateLocalizationService.SupportedCultures)
                                {
                                    <option value="@culture.Key" selected="@(culture.Key == currentCulture ? "selected" : null)">
                                        @culture.Value
                                    </option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="align-middle" data-lucide="printer"></i> @Localizer["Print"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
