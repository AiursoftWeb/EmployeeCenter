@using Aiursoft.EmployeeCenter.Authorization
@using Microsoft.AspNetCore.Authorization
@model Aiursoft.EmployeeCenter.Models.AudioViewModels.IndexViewModel
@inject IAuthorizationService AuthorizationService

@{
    var canManage = (await AuthorizationService.AuthorizeAsync(User, AppPermissionNames.CanManageAudio)).Succeeded;
    var totalCount = Model.TotalAudioCount;
    var transcribedCount = Model.Audios.Count(a => a.HasTranscript);
    var processingCount = Model.Audios.Count(a => !a.HasTranscript && a.Audio.AsrAttemptCount > 0);
    var pendingCount = Model.Audios.Count(a => !a.HasTranscript && a.Audio.AsrAttemptCount == 0);
}

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["Meeting Transcripts"]</h3>
    </div>

    <div class="col-auto ms-auto mt-n1">
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="align-middle" data-lucide="plus-circle"></i> @Localizer["Upload Meeting Recording"]
            </a>
        }
    </div>
</div>

<div class="row">
    <div class="col-12 col-sm-6 col-xxl-3 d-flex">
        <div class="card flex-fill">
            <div class="card-body py-4">
                <div class="d-flex align-items-start">
                    <div class="flex-grow-1">
                        <h3 class="mb-2">@totalCount</h3>
                        <p class="mb-2">@Localizer["Total Meetings"]</p>
                        <div class="mb-0">
                            <span class="text-muted">@Localizer["All uploaded meeting recordings"]</span>
                        </div>
                    </div>
                    <div class="d-inline-block ms-3">
                        <div class="stat">
                            <i class="align-middle text-primary" data-lucide="mic"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3 d-flex">
        <div class="card flex-fill">
            <div class="card-body py-4">
                <div class="d-flex align-items-start">
                    <div class="flex-grow-1">
                        <h3 class="mb-2">@transcribedCount</h3>
                        <p class="mb-2">@Localizer["Transcribed"]</p>
                        <div class="mb-0">
                            <span class="text-muted">@Localizer["Speech-to-text completed"]</span>
                        </div>
                    </div>
                    <div class="d-inline-block ms-3">
                        <div class="stat">
                            <i class="align-middle text-success" data-lucide="file-audio"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3 d-flex">
        <div class="card flex-fill">
            <div class="card-body py-4">
                <div class="d-flex align-items-start">
                    <div class="flex-grow-1">
                        <h3 class="mb-2">@processingCount</h3>
                        <p class="mb-2">@Localizer["Processing"]</p>
                        <div class="mb-0">
                            <span class="text-muted">@Localizer["Recognition in progress"]</span>
                        </div>
                    </div>
                    <div class="d-inline-block ms-3">
                        <div class="stat">
                            <i class="align-middle text-warning" data-lucide="loader"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xxl-3 d-flex">
        <div class="card flex-fill">
            <div class="card-body py-4">
                <div class="d-flex align-items-start">
                    <div class="flex-grow-1">
                        <h3 class="mb-2">@pendingCount</h3>
                        <p class="mb-2">@Localizer["Pending"]</p>
                        <div class="mb-0">
                            <span class="text-muted">@Localizer["Awaiting recognition"]</span>
                        </div>
                    </div>
                    <div class="d-inline-block ms-3">
                        <div class="stat">
                            <i class="align-middle text-secondary" data-lucide="clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Audios.Any())
{
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">@Localizer["Meeting Recordings"]</h5>
            <h6 class="card-subtitle text-muted">@Localizer["A list of meeting audio recordings, transcripts, and AI processing statuses."]</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Created Time"]</th>
                    <th>@Localizer["ASR Status"]</th>
                    <th class="text-end">@Localizer["Actions"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Audios)
                {
                    <tr>
                        <td>
                            <i class="align-middle me-2" data-lucide="mic"></i> @item.Audio.Name
                        </td>
                        <td><label class="text-muted" data-utc-time="@item.Audio.CreateTime.ToHtmlDateTime()"></label></td>
                        <td>
                            @if (item.HasTranscript)
                            {
                                <span class="badge bg-success">@Localizer["Transcribed"]</span>
                            }
                            else if (item.IsEmptyResult)
                            {
                                <span class="badge bg-warning">@Localizer["Empty"]</span>
                            }
                            else if (item.Audio.AsrAttemptCount > 0)
                            {
                                <span class="badge bg-info">@Localizer["Processing"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Localizer["Pending"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Transcript" asp-route-id="@item.Audio.Id" class="btn btn-sm btn-outline-secondary" title="@Localizer["Transcript"]">
                                <i class="align-middle" data-lucide="eye"></i> @Localizer["Transcript"]
                            </a>
                            @if (canManage)
                            {
                                <form asp-action="Delete" asp-route-id="@item.Audio.Id" method="post" class="d-inline" onsubmit="return confirm(getLocalizedText('delete-audio-confirm', 'Are you sure you want to delete this meeting recording?'));">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="align-middle" data-lucide="trash-2"></i> @Localizer["Delete"]
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.Page > 1 || Model.HasNextPage)
        {
            <div class="card-footer d-flex justify-content-between">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">@Localizer["Previous"]</a>
                }
                else
                {
                    <span></span>
                }
                @if (Model.HasNextPage)
                {
                    <a asp-action="Index" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">@Localizer["Next"]</a>
                }
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="align-middle text-muted mb-3" data-lucide="mic" style="width: 48px; height: 48px;"></i>
            <h5 class="mb-1">@Localizer["No meeting recordings yet"]</h5>
            <p class="text-muted mb-0">@Localizer["Upload your first meeting recording to transcribe and analyze with AI."]</p>
            @if (canManage)
            {
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="align-middle me-1" data-lucide="plus-circle"></i> @Localizer["Upload Meeting Recording"]
                </a>
            }
        </div>
    </div>
}

<div id="loc-data" class="d-none">
    <span data-key="delete-audio-confirm">@Localizer["Are you sure you want to delete this meeting recording?"]</span>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <partial name="_LocalizationHelper" />
}
