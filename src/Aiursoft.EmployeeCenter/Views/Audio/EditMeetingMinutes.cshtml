@model Aiursoft.EmployeeCenter.Models.AudioViewModels.EditMeetingMinutesViewModel

<h1 class="h3 mb-3">@Localizer["Edit Meeting Minutes"]</h1>

<form asp-action="EditMeetingMinutes" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="TranscriptRevision" type="hidden" />
    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <label asp-for="MeetingMinutesMarkdown" class="form-label">@Localizer["Meeting Minutes"]</label>
            <p class="text-muted">@Localizer["Paste or edit meeting minutes in Markdown. Saving stops automatic retries."]</p>
            <textarea asp-for="MeetingMinutesMarkdown" class="form-control font-monospace" rows="24"></textarea>
            <span asp-validation-for="MeetingMinutesMarkdown" class="text-danger"></span>
        </div>
        <div class="card-footer text-end">
            <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            <a asp-action="Transcript" asp-route-id="@Model.Id" class="btn btn-light">@Localizer["Cancel"]</a>
        </div>
    </div>
</form>
