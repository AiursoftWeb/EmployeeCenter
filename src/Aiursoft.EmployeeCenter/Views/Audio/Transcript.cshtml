@model Aiursoft.EmployeeCenter.Models.AudioViewModels.TranscriptViewModel
@using Aiursoft.EmployeeCenter.Configuration
@using Aiursoft.EmployeeCenter.Services.FileStorage
@using Microsoft.Extensions.Options
@inject IOptions<AsrSettings> AsrSettings
@inject IOptions<AppSettings> AppSettings
@inject StorageService StorageService
@inject Aiursoft.EmployeeCenter.Services.MarkdownDisplayService MarkdownDisplay

@{
    var hasTranscript = !string.IsNullOrEmpty(Model.PlainText);
    var hasFailed = !hasTranscript &&
        (Model.Audio.AsrAttemptCount >= AsrSettings.Value.AsrMaxRetryCount || Model.Audio.AsrTerminalError != null);
    var hasMeetingMinutes = !string.IsNullOrWhiteSpace(Model.MeetingMinutesMarkdown);
    var meetingMinutesFailed = hasTranscript && !hasMeetingMinutes && Model.MeetingMinutesAttemptCount >= AppSettings.Value.Agent.MeetingMinutesMaxRetryCount;
    var isTranscribing = !hasTranscript && !hasFailed && Model.Audio.AsrAttemptCount > 0;
    var hasPlayableMedia = Model.Audio.MediaStatus == AudioMediaStatus.Ready || Model.Audio.PendingFilePath != null;
    var audioUrl = hasPlayableMedia
        ? StorageService.RelativePathToInternetUrl(Model.Audio.FilePath, isVault: true)
        : null;
}

@if (Model.Audio.MediaStatus is AudioMediaStatus.Uploaded or AudioMediaStatus.Processing)
{
    <div class="alert alert-info alert-outline-coloured" role="alert">
        <div class="alert-icon"><i class="align-middle" data-lucide="loader"></i></div>
        <div class="alert-message">
            <strong>@Localizer["Processing uploaded media"]</strong>
            <div class="mt-1">@Localizer["The recording is being prepared in the background. The existing recording remains available during replacement."]</div>
        </div>
    </div>
}
else if (Model.Audio.MediaStatus == AudioMediaStatus.Failed)
{
    <div class="alert alert-danger alert-outline-coloured" role="alert">
        <div class="alert-icon"><i class="align-middle" data-lucide="x-circle"></i></div>
        <div class="alert-message">
            <strong>@Localizer["Media processing failed"]</strong>
            <div class="mt-1">@Model.Audio.MediaProcessingError</div>
        </div>
    </div>
}
else if (Model.Audio.MediaProcessingError != null)
{
    <div class="alert alert-warning alert-outline-coloured" role="alert">
        <div class="alert-icon"><i class="align-middle" data-lucide="alert-triangle"></i></div>
        <div class="alert-message">
            <strong>@Localizer["Media replacement failed"]</strong>
            <div class="mt-1">@Model.Audio.MediaProcessingError</div>
        </div>
    </div>
}

<div class="row mb-2 mb-xl-3">
    <div class="col-12 col-md">
        <h3 class="mb-1">@Localizer["Meeting Transcript"]</h3>
        <p class="text-muted mb-2 mb-md-0">
            <i class="align-middle me-1" data-lucide="mic"></i> @Model.Audio.Name
        </p>
    </div>
    <div class="col-12 col-md-auto mt-2 mt-md-0 text-md-end">
        @if (hasPlayableMedia)
        {
            <a href="@audioUrl" class="btn btn-light bg-white shadow-sm" target="_blank">
                <i class="align-middle me-1" data-lucide="download"></i> @Localizer["Download Audio"]
            </a>
        }
        @if (Model.Permission == SharePermission.Editable)
        {
            <a asp-action="Rename" asp-route-id="@Model.Audio.Id" class="btn btn-outline-primary shadow-sm">
                <i class="align-middle me-1" data-lucide="pencil"></i> @Localizer["Rename"]
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Audio.Id" class="btn btn-outline-primary shadow-sm">
                <i class="align-middle me-1" data-lucide="refresh-cw"></i> @Localizer["Replace Recording"]
            </a>
        }
        <a asp-action="Index" class="btn btn-secondary shadow-sm">
            <i class="align-middle me-1" data-lucide="arrow-left"></i> @Localizer["Back to List"]
        </a>
    </div>
</div>

@if (TempData["AsrTaskQueued"] is true)
{
    <div class="alert alert-success alert-outline-coloured" role="alert">
        <div class="alert-icon">
            <i class="align-middle" data-lucide="check-circle"></i>
        </div>
        <div class="alert-message">
            @Localizer["An offline ASR task has been created. Please do not create it again."]
        </div>
    </div>
}

@if (TempData["MeetingMinutesRegenerationQueued"] is true)
{
    <div class="alert alert-success alert-outline-coloured" role="alert">
        <div class="alert-icon"><i class="align-middle" data-lucide="check-circle"></i></div>
        <div class="alert-message">@Localizer["Meeting minutes regeneration has been queued."]</div>
    </div>
}

@if (TempData["AsrResetError"] is true)
{
    <div class="alert alert-danger alert-outline-coloured" role="alert">
        <div class="alert-icon">
            <i class="align-middle" data-lucide="alert-circle"></i>
        </div>
        <div class="alert-message">
            @Localizer["The active ASR task could not be cancelled. No changes were made. Please try again."]
        </div>
    </div>
}

@if (TempData["AsrResetUnavailable"] is true)
{
    <div class="alert alert-warning alert-outline-coloured" role="alert">
        <div class="alert-icon">
            <i class="align-middle" data-lucide="alert-triangle"></i>
        </div>
        <div class="alert-message">
            @Localizer["ASR can only be reset after media processing succeeds."]
        </div>
    </div>
}

<div class="row">
    <div class="col-12 col-xl-8">
        <div class="w-100">
            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <h5 class="card-title mb-0">@Localizer["Meeting Minutes"]</h5>
                    @if (Model.MeetingMinutesOutdated)
                    {
                        <span class="badge badge-subtle-warning ms-auto"><i class="align-middle me-1" data-lucide="alert-triangle"></i>@Localizer["Outdated"]</span>
                    }
                    else if (hasMeetingMinutes)
                    {
                        <span class="badge badge-subtle-success ms-auto"><i class="align-middle me-1" data-lucide="check"></i>@Localizer["Generated"]</span>
                    }
                    else if (meetingMinutesFailed)
                    {
                        <span class="badge badge-subtle-danger ms-auto"><i class="align-middle me-1" data-lucide="x-circle"></i>@Localizer["Failed"]</span>
                    }
                    else
                    {
                        <span class="badge badge-subtle-warning ms-auto">
                            <i class="align-middle me-1" data-lucide="loader"></i>@Localizer[hasTranscript ? "Generating meeting summary" : "Waiting for speech-to-text"]
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (Model.MeetingMinutesOutdated)
                    {
                        <div class="alert alert-warning alert-outline-coloured" role="alert">
                            <div class="alert-icon"><i class="align-middle" data-lucide="alert-triangle"></i></div>
                            <div class="alert-message">
                                <strong>@Localizer[hasMeetingMinutes ? "Meeting minutes may be outdated" : "Meeting minutes require manual generation"]</strong>
                                <div class="mt-1">
                                    @Localizer[hasMeetingMinutes
                                        ? "The transcript was edited after these meeting minutes were generated. Review the changes before regenerating."
                                        : "The transcript was edited. Generate meeting minutes manually when the text is ready."]
                                </div>
                                @if (Model.Permission == SharePermission.Editable)
                                {
                                    <form asp-action="RegenerateMeetingMinutes" method="post" class="mt-3" onsubmit="this.querySelector('button[type=submit]').disabled = true;">
                                        <input type="hidden" name="id" value="@Model.Audio.Id" />
                                        <button type="submit" class="btn btn-sm btn-warning">
                                            <i class="align-middle me-1" data-lucide="refresh-cw"></i> @Localizer[hasMeetingMinutes ? "Regenerate Meeting Minutes" : "Generate Meeting Minutes"]
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                    @if (hasMeetingMinutes)
                    {
                        <div class="markdown-content">@MarkdownDisplay.RenderMarkdown(Model.MeetingMinutesMarkdown)</div>
                    }
                    else if (!Model.MeetingMinutesOutdated && meetingMinutesFailed)
                    {
                        <div class="alert alert-danger alert-outline-coloured mb-0" role="alert">
                            <div class="alert-icon"><i class="align-middle" data-lucide="x-circle"></i></div>
                            <div class="alert-message">
                                <strong>@Localizer["Minutes Generation Failed"]</strong>
                                <div class="mt-1">@Localizer["Meeting minutes could not be generated after {0} attempts.", Model.MeetingMinutesAttemptCount]</div>
                                @if (Model.Permission == SharePermission.Editable)
                                {
                                    <form asp-action="RegenerateMeetingMinutes" method="post" class="mt-3" onsubmit="this.querySelector('button[type=submit]').disabled = true;">
                                        <input type="hidden" name="id" value="@Model.Audio.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="align-middle me-1" data-lucide="refresh-cw"></i> @Localizer["Retry Meeting Minutes"]
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                    else if (!Model.MeetingMinutesOutdated && hasTranscript)
                    {
                        <div class="alert alert-info alert-outline-coloured mb-0" role="alert">
                            <div class="alert-icon"><i class="align-middle" data-lucide="loader"></i></div>
                            <div class="alert-message">
                                <strong>@Localizer["Generating meeting summary"]</strong>
                                <div class="mt-1">@Localizer["Speech-to-text is complete. The meeting summary is now being prepared."]</div>
                                <div class="progress mt-3" style="height: 0.4rem;" role="progressbar" aria-label="@Localizer["Generating meeting summary"]">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary alert-outline-coloured mb-0" role="alert">
                            <div class="alert-icon"><i class="align-middle" data-lucide="clock"></i></div>
                            <div class="alert-message">
                                <strong>@Localizer["Waiting for speech-to-text to finish"]</strong>
                                <div class="mt-1">@Localizer["The meeting summary will start automatically after speech-to-text is complete."]</div>
                                <div class="progress mt-3" style="height: 0.4rem;" role="progressbar" aria-label="@Localizer["Waiting for speech-to-text to finish"]">
                                    <div class="progress-bar bg-secondary progress-bar-striped progress-bar-animated w-100"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        <div class="card flex-fill w-100">
            <div class="card-header d-flex align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="card-title mb-0">@Localizer["Transcribed Text"]</h5>
                    <small class="text-muted">@Model.Audio.Name</small>
                </div>
                @if (hasTranscript)
                {
                    <div class="ms-auto d-flex gap-2">
                        @if (Model.Permission == SharePermission.Editable)
                        {
                            <a asp-action="EditTranscript" asp-route-id="@Model.Audio.Id" class="btn btn-sm btn-outline-primary" title="@Localizer["Correct transcription errors"]">
                                <i class="align-middle me-1" data-lucide="pencil"></i> @Localizer["Edit Transcript"]
                            </a>
                        }
                        <button class="btn btn-sm btn-outline-secondary" type="button" onclick="copyTranscript(this)" title="@Localizer["Copy to clipboard"]">
                            <i class="align-middle me-1" data-lucide="copy"></i> @Localizer["Copy"]
                        </button>
                        <a href="@Url.Action("Export", new { id = Model.Audio.Id })" class="btn btn-sm btn-outline-primary" title="@Localizer["Export as text file"]">
                            <i class="align-middle me-1" data-lucide="download"></i> @Localizer["Export .txt"]
                        </a>
                        <a href="@Url.Action("RawText", new { id = Model.Audio.Id })" target="_blank" class="btn btn-sm btn-outline-info" title="@Localizer["View the current transcript as plain text"]">
                            <i class="align-middle me-1" data-lucide="code"></i> @Localizer["Transcript API"]
                        </a>
                    </div>
                }
            </div>
            <div class="card-body">
                @if (!hasTranscript)
                {
                    <div class="alert @(hasFailed ? "alert-danger" : "alert-info") alert-outline-coloured mb-0" role="alert">
                        <div class="alert-icon">
                            <i class="align-middle" data-lucide="@(hasFailed ? "x-circle" : "info")"></i>
                        </div>
                        <div class="alert-message">
                            @if (hasFailed)
                            {
                                <strong>@Localizer["Processing Failed"]</strong>
                                <div class="mt-1">@Localizer["ASR processing has failed after {0} attempts. You can reset the retry counter and try again.", Model.Audio.AsrAttemptCount]</div>
                            }
                            else
                            {
                                <strong>@Localizer[isTranscribing ? "Transcribing audio" : "Waiting to transcribe audio"]</strong>
                                <div class="mt-1">
                                    @Localizer[isTranscribing
                                        ? "Speech-to-text is processing the recording. The transcript will appear here automatically when it is ready."
                                        : "The speech-to-text task is queued and will begin shortly."]
                                </div>
                                <div class="progress mt-3" style="height: 0.4rem;" role="progressbar" aria-label="@Localizer[isTranscribing ? "Transcribing audio" : "Waiting to transcribe audio"]">
                                    <div class="progress-bar @(isTranscribing ? "" : "bg-secondary") progress-bar-striped progress-bar-animated w-100"></div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <pre id="transcript-text" class="bg-light border rounded p-3 mb-0" style="white-space: pre-wrap; max-height: 65vh; overflow-y: auto;">@Model.PlainText</pre>
                }
            </div>
        </div>
        </div>
    </div>
    <div class="col-12 col-xl-4 d-flex">
        <div class="w-100">
            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <h5 class="card-title mb-0">@Localizer["Audio File"]</h5>
                    @if (hasTranscript)
                    {
                        <span class="badge badge-subtle-success ms-auto"><i class="align-middle me-1" data-lucide="check"></i>@Localizer["Transcribed"]</span>
                    }
                    else if (hasFailed)
                    {
                        <span class="badge badge-subtle-danger ms-auto"><i class="align-middle me-1" data-lucide="x-circle"></i>@Localizer["Failed"]</span>
                    }
                    else if (Model.Audio.AsrAttemptCount > 0)
                    {
                        <span class="badge badge-subtle-warning ms-auto"><i class="align-middle me-1" data-lucide="loader"></i>@Localizer["Processing"]</span>
                    }
                    else
                    {
                        <span class="badge badge-subtle-secondary ms-auto"><i class="align-middle me-1" data-lucide="clock"></i>@Localizer["Pending"]</span>
                    }
                </div>
                <div class="card-body">
                    @if (hasPlayableMedia)
                    {
                        <audio controls preload="metadata" class="w-100">
                            <source src="@audioUrl">
                            @Localizer["Your browser does not support audio playback."]
                        </audio>
                    }
                    else
                    {
                        <span class="text-muted">@Localizer["No playable audio is available."]</span>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Status Info"]</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">@Localizer["Attempt Count"]</span>
                        <span class="fw-semibold">@Model.Audio.AsrAttemptCount / @AsrSettings.Value.AsrMaxRetryCount</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">@Localizer["Last Attempt"]</span>
                        <span class="text-end">
                            @if (Model.Audio.LastAsrAttemptTime.HasValue)
                            {
                                <label data-utc-time="@Model.Audio.LastAsrAttemptTime.Value.ToHtmlDateTime()"></label>
                            }
                            else
                            {
                                @Localizer["Never"]
                            }
                        </span>
                    </div>
                </div>
                @if (Model.CanManageShares && Model.Audio.MediaStatus == AudioMediaStatus.Ready)
                {
                    <div class="card-footer">
                        <button type="button" class="btn btn-warning w-100" data-bs-toggle="modal" data-bs-target="#resetAsrModal">
                            <i class="align-middle me-1" data-lucide="refresh-cw"></i> @Localizer["Reset & Retry ASR"]
                        </button>
                    </div>
                }
            </div>

            @if (Model.CanManageShares)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">@Localizer["Sharing"]</h5>
                    </div>
                    <div class="card-body">
                        <a asp-action="ManageShares" asp-route-id="@Model.Audio.Id" class="btn btn-sm btn-outline-secondary w-100">
                            <i class="align-middle me-1" data-lucide="share-2"></i> @Localizer["Manage Shares"]
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.CanManageShares && Model.Audio.MediaStatus == AudioMediaStatus.Ready)
{
    <div class="modal modal-blur fade" id="resetAsrModal" tabindex="-1" role="dialog" aria-labelledby="resetAsrModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="resetAsrModalLabel">@Localizer["Confirm ASR Reset"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                </div>
                <form asp-action="ResetAsr" method="post" onsubmit="this.querySelector('button[type=submit]').disabled = true;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Audio.Id" />
                    <div class="modal-body">
                        <p class="mb-0">
                            @Localizer["Resetting ASR will delete the current transcript and segment results, reset the retry counter, and create a new offline task. Are you sure you want to continue?"]
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <button type="submit" class="btn btn-warning ms-auto">
                            <i class="align-middle me-1" data-lucide="refresh-cw"></i> @Localizer["Confirm Reset"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    @if (hasMeetingMinutes)
    {
        <partial name="_MarkdownReaderAssets" />
    }
    <script>
        function copyTranscript(button) {
            const text = document.getElementById('transcript-text')?.innerText;
            if (!text) return;
            navigator.clipboard.writeText(text).then(() => {
                const original = button.innerHTML;
                button.innerHTML = '<i class="align-middle me-1" data-lucide="check"></i> @Localizer["Copied"]';
                button.classList.remove('btn-outline-secondary');
                button.classList.add('btn-success');
                setTimeout(() => { button.innerHTML = original; button.classList.remove('btn-success'); button.classList.add('btn-outline-secondary'); }, 2000);
            });
        }
    </script>
}
