@model Aiursoft.EmployeeCenter.Models.AudioViewModels.CreateViewModel

<h1 class="h3 mb-3">@Localizer["Upload Meeting Recording"]</h1>

<div class="row">
    <div class="col-12 col-xl-6">
        <form asp-action="Create" method="post">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Meeting Recording Details"]</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">@Localizer["Name"]</label>
                        <input asp-for="Name" class="form-control" placeholder="@Localizer["e.g. Meeting Recording 2024-01-01"]" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UploadId" class="form-label">@Localizer["Meeting Audio or Video File"]</label>
                        <vc:file-upload
                            asp-for="UploadId"
                            subfolder="audio"
                            allowed-extensions="mp3 wav m4a ogg flac aac webm amr mp4 mov mkv avi"
                            is-vault="true"
                            upload-endpoint="@Url.Action("Upload", "AudioUploads", new { purpose = "create" })">
                        </vc:file-upload>
                        <span asp-validation-for="UploadId" class="text-danger"></span>
                        <div class="form-text">@Localizer["Upload an audio file or a video file. Video uploads are saved as audio only and the original video is discarded."]</div>
                    </div>

                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="align-middle me-2" data-lucide="check-circle"></i> @Localizer["Upload Meeting Recording"]
                    </button>
                    <a asp-action="Index" class="btn btn-light">@Localizer["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/dropify/dist/css/dropify.min.css" />
    <link rel="stylesheet" href="~/styles/uploader.css" />
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/node_modules/dropify/dist/js/dropify.min.js"></script>
}
