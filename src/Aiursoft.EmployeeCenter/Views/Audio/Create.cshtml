@model Aiursoft.EmployeeCenter.Models.AudioViewModels.CreateViewModel

<h1 class="h3 mb-3">@Localizer["Upload Meeting Recording"]</h1>

<div class="row">
    <div class="col-12 col-xl-6">
        <form asp-action="Create" method="post">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Meeting Recording Details"]</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">@Localizer["Name"]</label>
                        <input asp-for="Name" class="form-control" placeholder="@Localizer["e.g. Meeting Recording 2024-01-01"]" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FilePath" class="form-label">@Localizer["Meeting Audio File"]</label>
                        <vc:file-upload
                            asp-for="FilePath"
                            subfolder="audio"
                            allowed-extensions="mp3 wav m4a ogg flac aac webm amr"
                            is-vault="true">
                        </vc:file-upload>
                        <span asp-validation-for="FilePath" class="text-danger"></span>
                        <div class="form-text">@Localizer["Upload a meeting recording file. It will be automatically transcribed to text, ready for archiving and subsequent AI analysis."]</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ViewScope" class="form-label">@Localizer["View Scope"]</label>
                        <select asp-for="ViewScope" class="form-select">
                            <option value="0">@Localizer["Only me (Private)"]</option>
                            <option value="1">@Localizer["My department"]</option>
                            <option value="2">@Localizer["Everyone (CanViewAudio)"]</option>
                        </select>
                        <span asp-validation-for="ViewScope" class="text-danger"></span>
                        <div class="form-text">@Localizer["Who can view this recording and its transcript. You can change it later or share it with specific users/roles."]</div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="align-middle me-2" data-lucide="check-circle"></i> @Localizer["Upload Meeting Recording"]
                    </button>
                    <a asp-action="Index" class="btn btn-light">@Localizer["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/dropify/dist/css/dropify.min.css" />
    <link rel="stylesheet" href="~/styles/uploader.css" />
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/node_modules/dropify/dist/js/dropify.min.js"></script>
}
