@model Aiursoft.EmployeeCenter.Models.AudioViewModels.RenameViewModel

<h1 class="h3 mb-3">@Localizer["Rename Meeting Recording"]</h1>

<div class="row">
    <div class="col-12 col-xl-6">
        <form asp-action="Rename" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Meeting Recording Name"]</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">@Localizer["Name"]</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="align-middle me-2" data-lucide="check-circle"></i> @Localizer["Save"]
                    </button>
                    <a asp-action="Transcript" asp-route-id="@Model.Id" class="btn btn-light">@Localizer["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>
</div>
